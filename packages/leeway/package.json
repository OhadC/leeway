{
    "name": "leeway",
    "version": "0.2.0",
    "description": "Per-folder dev port ranges so parallel worktrees and agents never fight over ports",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/OhadC/leeway.git",
        "directory": "packages/leeway"
    },
    "homepage": "https://github.com/OhadC/leeway/tree/main/packages/leeway#readme",
    "bugs": "https://github.com/OhadC/leeway/issues",
    "type": "module",
    "engines": {
        "node": ">=22.18"
    },
    "files": [
        "dist"
    ],
    "bin": {
        "leeway": "./dist/cli.mjs"
    },
    "scripts": {
        "build": "tsdown",
        "prepublishOnly": "pnpm build",
        "test": "vitest",
        "typecheck": "tsc -p tsconfig.json"
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "tsdown": "^0.23.1",
        "vite": "^8.3.4",
        "vitest": "^5.0.5"
    },
    "exports": {
        ".": "./dist/index.mjs",
        "./vite": "./dist/vite.mjs",
        "./package.json": "./package.json"
    },
    "peerDependencies": {
        "vite": ">=7"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    }
}
