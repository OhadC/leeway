{
    "name": "leeway-playground",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "leeway pnpm run \"/^serve:/\"",
        "dev:default": "leeway --default pnpm run \"/^serve:/\"",
        "serve:web": "leeway --inherit vite",
        "serve:api": "leeway --inherit node server.ts",
        "hello": "leeway curl -s http://localhost:{{PORT_API}}",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "leeway": "workspace:*"
    },
    "devDependencies": {
        "vite": "^8.3.4"
    }
}
