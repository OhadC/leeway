{
    "name": "leeway-playground",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "leeway vite",
        "api": "leeway node server.ts",
        "dev:default": "leeway --default vite",
        "both": "leeway pnpm run \"/^serve:/\"",
        "both:default": "leeway --default pnpm run \"/^serve:/\"",
        "serve:web": "leeway --inherit vite",
        "serve:api": "leeway --inherit node server.ts",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "leeway": "workspace:*"
    },
    "devDependencies": {
        "vite": "^8.3.4"
    }
}
